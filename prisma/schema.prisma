generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── AUTH & USERS ───────────────────────────────────────────────

enum WorkspaceMode {
  POS
  PERSONAL
}

model User {
  id                     String         @id @default(cuid())
  email                  String         @unique
  googleId               String?        @unique
  phone                  String?        @unique
  password               String?
  name                   String
  mode                   WorkspaceMode?
  avatar                 String?
  customAiConfig         Json?
  aiInsight              String?
  aiInsightUpdatedAt     DateTime?
  financialCycleStartDay Int            @default(1)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt

  // Relations
  otpCodes          OtpCode[]
  sessions          Session[]
  accounts          Account[]
  transactions      Transaction[]
  categories        Category[]
  products          Product[]
  customers         Customer[]
  aiMessages        AiMessage[]
  aiConversations   AiConversation[]
  deviceTokens      DeviceToken[]
  subscriptions     Subscription[]
  budgets           Budget[]
  investmentAssets  InvestmentAsset[]
  savingGoals       SavingGoal[]
  notifications     Notification[]
  aiActionRequests  AiActionRequest[]
  posProfile        PosProfile?
  sales             Sale[]
  stockMovements    StockMovement[]
  registerSessions  RegisterSession[]
  receivableEntries ReceivableEntry[]
}

// ─── NOTIFICATION TYPES ─────────────────────────────────────────

enum NotificationType {
  EXPENSE_ALERT
  BUDGET_EXCEEDED
  SUBSCRIPTION_REMINDER
  DAILY_RECAP
  ADMIN_BROADCAST
  SYSTEM
  POS_DEBT
  POS_DEBT_PAYMENT
  POS_LOW_STOCK
  POS_DAILY_RECAP
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        NotificationType @default(SYSTEM)
  title       String
  body        String
  isRead      Boolean          @default(false)
  clickAction String?          @default("/dashboard")
  createdAt   DateTime         @default(now())

  @@index([userId, isRead])
  @@index([userId, createdAt])
}

model OtpCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  code      String
  type      String // REGISTER, LOGIN, FORGOT_PASSWORD
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, type])
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  refreshToken String   @unique
  deviceInfo   String?
  ipAddress    String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  @@index([userId])
}

// ─── WALLET / ACCOUNTS ──────────────────────────────────────────

enum AccountType {
  CASH
  BANK
  E_WALLET
  INVESTMENT
}

model Account {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  name      String
  type      AccountType @default(CASH)
  currency  String      @default("IDR")
  balance   Float       @default(0)
  icon      String?
  color     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  transactions     Transaction[]
  investmentAssets InvestmentAsset[]

  @@index([userId])
}

// ─── TRANSACTIONS ───────────────────────────────────────────────

enum TransactionType {
  INCOME
  EXPENSE
  DEBT
  DEBT_PAYMENT
}

model Transaction {
  id                  String          @id @default(cuid())
  userId              String
  user                User            @relation(fields: [userId], references: [id])
  accountId           String?
  account             Account?        @relation(fields: [accountId], references: [id])
  categoryId          String?
  category            Category?       @relation(fields: [categoryId], references: [id])
  customerId          String?
  customer            Customer?       @relation(fields: [customerId], references: [id])
  type                TransactionType
  amount              Float
  currency            String          @default("IDR")
  exchangeRate        Float           @default(1.0)
  description         String?
  note                String?
  method              String? // cash, debit_card, credit_card, e_wallet
  source              String? // CHAT, SCAN, MANUAL
  date                DateTime        @default(now())
  isTransfer          Boolean         @default(false)
  receiptUrl          String?
  splitGroupId        String?
  linkedTransactionId String?
  linkedTransaction   Transaction?    @relation("LinkedTrans", fields: [linkedTransactionId], references: [id])
  linkedFrom          Transaction[]   @relation("LinkedTrans")
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([userId, date])
  @@index([userId, categoryId])
  @@index([userId, customerId])
}

// ─── CATEGORIES ─────────────────────────────────────────────────

model Category {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  name      String
  icon      String?
  color     String?
  type      TransactionType // INCOME or EXPENSE
  isDefault Boolean         @default(false)
  order     Int             @default(0)
  createdAt DateTime        @default(now())

  transactions Transaction[]
  budgets      Budget[]

  @@unique([userId, name])
  @@index([userId, type])
}

// ─── POS: PRODUCTS ──────────────────────────────────────────────

model Product {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  sku       String?
  barcode   String?
  price     Decimal  @db.Decimal(18, 2)
  costPrice Decimal? @db.Decimal(18, 2)
  category  String?
  unit      String   @default("pcs")
  stock     Decimal  @default(0) @db.Decimal(18, 3)
  minStock  Decimal  @default(5) @db.Decimal(18, 3)
  image     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]

  @@unique([userId, sku])
  @@unique([userId, barcode])
  @@index([userId])
  @@index([userId, isActive])
}

// ─── POS: CUSTOMERS (for debt/kasbon tracking) ──────────────────

model Customer {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  phone     String?
  debt      Decimal  @default(0) @db.Decimal(18, 2)
  maxDebt   Decimal? @db.Decimal(18, 2)
  notes     String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions Transaction[]
  sales        Sale[]
  receivables  ReceivableEntry[]

  @@index([userId])
}

// ─── POS: SALES, PAYMENTS, INVENTORY & RECEIVABLES ──────────────

enum SaleStatus {
  COMPLETED
  VOIDED
}

enum PosPaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
  CARD
  CREDIT
}

enum StockMovementType {
  INITIAL
  PURCHASE
  SALE
  ADJUSTMENT
  RETURN
  VOID
}

enum ReceivableEntryType {
  CHARGE
  PAYMENT
  ADJUSTMENT
  VOID
}

enum RegisterStatus {
  OPEN
  CLOSED
}

model PosProfile {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  businessName  String   @default("Usaha Saya")
  address       String?
  phone         String?
  receiptFooter String?
  taxPercent    Decimal  @default(0) @db.Decimal(5, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RegisterSession {
  id           String         @id @default(cuid())
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       RegisterStatus @default(OPEN)
  openingCash  Decimal        @default(0) @db.Decimal(18, 2)
  expectedCash Decimal?       @db.Decimal(18, 2)
  closingCash  Decimal?       @db.Decimal(18, 2)
  notes        String?
  openedAt     DateTime       @default(now())
  closedAt     DateTime?
  sales        Sale[]
  payments     SalePayment[]

  @@index([userId, status])
  @@index([userId, openedAt])
}

model Sale {
  id                String            @id @default(cuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId        String?
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  registerSessionId String?
  registerSession   RegisterSession?  @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  invoiceNumber     String            @unique
  idempotencyKey    String
  status            SaleStatus        @default(COMPLETED)
  subtotal          Decimal           @db.Decimal(18, 2)
  discount          Decimal           @default(0) @db.Decimal(18, 2)
  tax               Decimal           @default(0) @db.Decimal(18, 2)
  total             Decimal           @db.Decimal(18, 2)
  paidAmount        Decimal           @default(0) @db.Decimal(18, 2)
  creditAmount      Decimal           @default(0) @db.Decimal(18, 2)
  outstandingAmount Decimal           @default(0) @db.Decimal(18, 2)
  changeAmount      Decimal           @default(0) @db.Decimal(18, 2)
  notes             String?
  voidReason        String?
  voidedAt          DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  items             SaleItem[]
  payments          SalePayment[]
  stockMovements    StockMovement[]
  receivables       ReceivableEntry[]

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([customerId, outstandingAmount])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  sku         String?
  quantity    Decimal  @db.Decimal(18, 3)
  unit        String
  unitPrice   Decimal  @db.Decimal(18, 2)
  unitCost    Decimal  @default(0) @db.Decimal(18, 2)
  subtotal    Decimal  @db.Decimal(18, 2)

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id                String           @id @default(cuid())
  saleId            String
  sale              Sale             @relation(fields: [saleId], references: [id], onDelete: Cascade)
  registerSessionId String?
  registerSession   RegisterSession? @relation(fields: [registerSessionId], references: [id], onDelete: SetNull)
  method            PosPaymentMethod
  amount            Decimal          @db.Decimal(18, 2)
  reference         String?
  createdAt         DateTime         @default(now())

  @@index([saleId])
  @@index([registerSessionId, createdAt])
}

model StockMovement {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  saleId      String?
  sale        Sale?             @relation(fields: [saleId], references: [id], onDelete: SetNull)
  type        StockMovementType
  quantity    Decimal           @db.Decimal(18, 3)
  stockBefore Decimal           @db.Decimal(18, 3)
  stockAfter  Decimal           @db.Decimal(18, 3)
  note        String?
  createdAt   DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([productId, createdAt])
  @@index([saleId])
}

model ReceivableEntry {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  customerId String
  customer   Customer            @relation(fields: [customerId], references: [id], onDelete: Cascade)
  saleId     String?
  sale       Sale?               @relation(fields: [saleId], references: [id], onDelete: SetNull)
  type       ReceivableEntryType
  amount     Decimal             @db.Decimal(18, 2)
  method     PosPaymentMethod?
  note       String?
  createdAt  DateTime            @default(now())

  @@index([userId, createdAt])
  @@index([customerId, createdAt])
  @@index([saleId])
}

// ─── SUBSCRIPTIONS & RECURRING BILLS ────────────────────────────

model Subscription {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String // "Netflix", "Bayar Kos"
  amount      Float
  cycle       String // "MONTHLY", "YEARLY", "WEEKLY"
  nextDueDate DateTime
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive, nextDueDate])
}

// ─── AI ─────────────────────────────────────────────────────────

model AiConversation {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String?
  mode      String? // POS or PERSONAL
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages AiMessage[]

  @@index([userId])
}

model AiMessage {
  id              String            @id @default(cuid())
  conversationId  String
  conversation    AiConversation    @relation(fields: [conversationId], references: [id])
  userId          String
  user            User              @relation(fields: [userId], references: [id])
  role            String // USER, ASSISTANT, SYSTEM
  content         String
  metadata        Json? // Parsed transaction data, etc.
  createdAt       DateTime          @default(now())
  proposedActions AiActionRequest[] @relation("AiActionProposalMessage")

  @@index([conversationId])
  @@index([userId])
}

enum AiActionStatus {
  PENDING
  EXECUTING
  EXECUTED
  CANCELLED
  EXPIRED
  FAILED
}

model AiActionRequest {
  id                String         @id @default(cuid())
  userId            String
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  proposalMessageId String?
  proposalMessage   AiMessage?     @relation("AiActionProposalMessage", fields: [proposalMessageId], references: [id], onDelete: SetNull)
  actionType        String
  arguments         Json
  title             String
  summary           String
  status            AiActionStatus @default(PENDING)
  idempotencyKey    String         @unique
  result            Json?
  error             String?
  expiresAt         DateTime
  executedAt        DateTime?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId, status])
  @@index([proposalMessageId])
  @@index([expiresAt])
}

// ─── PUSH NOTIFICATIONS (Firebase Cloud Messaging) ─────────────

model DeviceToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web") // web, ios, android
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

// ─── BUDGETS ───────────────────────────────────────────────────

model Budget {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  amount     Float
  period     String    @default("MONTHLY") // MONTHLY, WEEKLY, YEARLY
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId])
}

// ─── INVESTMENTS ───────────────────────────────────────────────

model InvestmentAsset {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id])
  symbol       String // e.g. BBCA, BTC, Gold
  quantity     Float
  averagePrice Float
  currentPrice Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId, accountId])
}

// ─── SAVING GOALS & WISHLIST ───────────────────────────────────

model SavingGoal {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String // e.g. "Beli Laptop", "DP Rumah", "Dana Darurat"
  targetAmount  Float
  currentAmount Float     @default(0)
  targetDate    DateTime?
  icon          String?   @default("target")
  color         String?   @default("#4f378a")
  isCompleted   Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId])
}
